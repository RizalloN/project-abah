APP_NAME="Dashboard A-Six"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/project-ABAH

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SECURITY_ADMIN_SENSITIVE_LIMIT_PER_MINUTE=30
SECURITY_AUTH_SENSITIVE_LIMIT_PER_MINUTE=12
VIEW_COMPILED_PATH=storage/framework/cache/blade

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
IMPORT_CACHE_STORE=file
# Local/staging worker pool used by composer start.
# Tune these higher on powerful machines; set to 0 to disable a pool.
ABAH_IMPORT_WORKERS=3
ABAH_REPORT_WORKERS=3
ABAH_SNAPSHOT_WORKERS=2
ABAH_SHADOW_WORKERS=2
ABAH_WORKER_MEMORY=512

CACHE_STORE=file
# Set to redis for production: CACHE_STORE=redis IMPORT_CACHE_STORE=redis
SNAPSHOT_ENABLE_ANALYZE_TABLE=false
DB_CONNECT_TIMEOUT=3
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
