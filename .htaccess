<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan pernah sajikan source, secret, log, atau entrypoint PHP tambahan.
    RewriteRule ^(?:\.git|\.agents|\.codex)(?:/|$) - [R=404,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|artisan|AGENTS\.md)$ - [R=404,L,NC]
    RewriteCond %{REQUEST_URI} !/(?:public/)?index\.php$
    RewriteRule \.php$ - [R=404,L,NC]

    # Pertahankan asset public storage, lalu blok storage internal aplikasi.
    RewriteCond %{DOCUMENT_ROOT}/project-ABAH/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]
    RewriteRule ^storage(?:/|$) - [R=404,L,NC]

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor|node_modules|scripts)(?:/|$) - [R=404,L,NC]

    # Biarkan direct access ke folder public bila memang dipanggil eksplisit.
    RewriteRule ^public/ - [L]

    # Sajikan asset/file dari folder public tanpa perlu /public di URL.
    RewriteCond $1 !^$
    RewriteCond %{DOCUMENT_ROOT}/project-ABAH/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/project-ABAH/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Selain itu, arahkan semua route ke front controller Laravel di root project.
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes

<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
    php_flag session.use_strict_mode On
    php_flag session.cookie_httponly On
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By

    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
