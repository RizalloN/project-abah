<IfModule mod_rewrite.c>
    RewriteEngine On

    # Biarkan file yang memang ada di root project.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Biarkan direct access ke folder public bila memang dipanggil eksplisit.
    RewriteRule ^public/ - [L]

    # Sajikan asset/file dari folder public tanpa perlu /public di URL.
    RewriteCond $1 !^$
    RewriteCond %{DOCUMENT_ROOT}/project-ABAH/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/project-ABAH/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Selain itu, arahkan semua route ke front controller Laravel di root project.
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
