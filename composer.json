{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "phpoffice/phpspreadsheet": "^5.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#a78bfa,#fdba74,#f59e0b,#60a5fa,#38bdf8,#22c55e,#14b8a6\" \"php artisan serve\" \"php artisan queue:work --queue=imports-high --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=imports-daily-loan --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=default,reports-low --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=remote-sources --tries=3 --timeout=360 --sleep=2\" \"php artisan queue:work --queue=snapshots-priority --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=snapshots-parallel --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=shadow-backfill --tries=1 --timeout=0 --sleep=1\" \"php artisan schedule:work\" \"npm run dev\" --names=server,import-queue,daily-loan-queue,main-queue,remote-sources,priority-snapshot,snapshot-queue,shadow-queue,scheduler,vite --kill-others"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1"
        ],
        "start:vite": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1 -WithVite"
        ],
        "start:staging": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1 -ImportWorkers 4 -ReportWorkers 4 -SnapshotWorkers 3 -ShadowWorkers 3"
        ],
        "start:power": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1 -ImportWorkers 6 -ReportWorkers 6 -SnapshotWorkers 4 -ShadowWorkers 4"
        ],
        "stop:power": [
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-power.ps1"
        ],
        "stop:workers": [
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-power.ps1 -IncludeLegacy"
        ],
        "queue": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File .\\scripts\\queue-persistent.ps1"
        ],
        "ddns:update": "D:\\XAMPP\\htdocs\\project-ABAH\\ddns-update.bat",

        "queue:all": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#c4b5fd,#fb7185\" \"php artisan queue:work --queue=imports-high --tries=1 --timeout=0 --sleep=1\" \"php artisan queue:work --queue=default,reports-low --tries=1 --timeout=0 --sleep=1\" --names=import-queue,report-queue --kill-others"
        ],
        "backfill:now": [
            "Composer\\Config::disableProcessTimeout",
            "php artisan shadow:backfill --chunk-size=10000 --retry-count=5 --live"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-and-restore-cache.ps1"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
